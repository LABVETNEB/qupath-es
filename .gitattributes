.gitattributes text eol=lf

# Canonical QuPath files: preserve bytes exactly
versions/*/base/* -text

# Project-authored text files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.tsv text eol=lf

# Generated localization bundles.
# Byte-exact, like the canonical base: release SHA-256 values are computed over
# these bytes and the files are installed verbatim, so Git must not rewrite
# line endings. Core 0.7.0 uses CRLF; extension bundles may use LF. In both
# cases the repository blob, checkout and installed bytes must stay identical.
versions/*/dist/*.properties -text
components/**/l10n/**/dist/*.properties -text

# Runtime helper scripts are project-authored text.
versions/*/runtime/*.groovy text eol=lf
runtime/*.groovy text eol=lf
runtime/*.ps1 text eol=lf
