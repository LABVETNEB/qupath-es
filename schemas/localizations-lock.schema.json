{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qupath-es localization language axis",
  "description": "Per-QuPath, per-locale localization state. Component identity and source/runtime pins remain in the component registry and components lockfile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qupath_version",
    "declared_at",
    "localizations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "qupath_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "declared_at": {
      "$ref": "#/$defs/date"
    },
    "localizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/localizationState"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableRepoPath": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(components|versions)/"
        }
      ]
    },
    "localizationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "locale",
        "revision",
        "source_of_truth",
        "dist_bundle",
        "translation_status",
        "validation_status",
        "distribution_status"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "revision": {
          "$ref": "#/$defs/nullableString"
        },
        "source_of_truth": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "dist_bundle": {
          "$ref": "#/$defs/nullableRepoPath"
        },
        "translation_status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "TRANSLATED"
          ]
        },
        "validation_status": {
          "enum": [
            "NOT_APPLICABLE",
            "NOT_VALIDATED",
            "VALIDATED"
          ]
        },
        "distribution_status": {
          "enum": [
            "UNSUPPORTED",
            "EXPERIMENTAL",
            "DISTRIBUTED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "translation_status": {
                "const": "NOT_STARTED"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "null"
              },
              "source_of_truth": {
                "type": "null"
              },
              "dist_bundle": {
                "type": "null"
              },
              "validation_status": {
                "const": "NOT_APPLICABLE"
              },
              "distribution_status": {
                "const": "UNSUPPORTED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "translation_status": {
                "enum": [
                  "IN_PROGRESS",
                  "TRANSLATED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_of_truth": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(components|versions)/"
              },
              "dist_bundle": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(components|versions)/"
              }
            }
          }
        }
      ]
    }
  }
}
