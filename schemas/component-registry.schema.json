{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qupath-es component registry",
  "description": "Stable component identities for QuPath Core and the extension corpus. Compatibility and version pins belong in per-QuPath lockfiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_name",
        "repository",
        "owner",
        "type",
        "priority",
        "role",
        "license",
        "build_system",
        "entry_point",
        "satellite_fork",
        "first_registered"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "QUPATH_CORE",
            "QUPATH_EXTENSION"
          ]
        },
        "priority": {
          "enum": [
            "BASE",
            "P0",
            "P0/P1",
            "P1"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "build_system": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": [
            "string",
            "null"
          ]
        },
        "satellite_fork": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          ]
        },
        "first_registered": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
