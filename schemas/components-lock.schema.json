{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qupath-es component lock",
  "description": "Per-QuPath reproducibility pins for the registered component corpus. This file records exact source pins and localization/distribution state without claiming runtime compatibility that has not been verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qupath_version",
    "qupath_upstream_commit",
    "locked_at",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "qupath_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "qupath_upstream_commit": {
      "$ref": "#/$defs/sha1"
    },
    "locked_at": {
      "$ref": "#/$defs/date"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/componentPin"
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableRepository": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      ]
    },
    "componentPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "upstream_tag",
        "upstream_commit",
        "pin_basis",
        "artifact_name",
        "artifact_url",
        "artifact_sha256",
        "declared_qupath_api",
        "runtime_compatibility",
        "localization_revision",
        "audit_status",
        "translation_status",
        "validation_status",
        "distribution_status",
        "fork_repo",
        "fork_tag",
        "patches",
        "last_audited"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "upstream_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_commit": {
          "$ref": "#/$defs/sha1"
        },
        "pin_basis": {
          "enum": [
            "FROZEN_TARGET_COMMIT",
            "QUPATH_BUNDLED",
            "UPSTREAM_RELEASE",
            "AUDITED_COMMIT"
          ]
        },
        "artifact_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "declared_qupath_api": {
          "type": "string",
          "minLength": 1
        },
        "runtime_compatibility": {
          "enum": [
            "FROZEN_TARGET",
            "BUNDLED_WITH_TARGET",
            "NOT_VERIFIED"
          ]
        },
        "localization_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_status": {
          "enum": [
            "AUDITED",
            "NOT_AUDITED"
          ]
        },
        "translation_status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "TRANSLATED"
          ]
        },
        "validation_status": {
          "enum": [
            "NOT_APPLICABLE",
            "NOT_VALIDATED",
            "VALIDATED"
          ]
        },
        "distribution_status": {
          "enum": [
            "UNSUPPORTED",
            "EXPERIMENTAL",
            "DISTRIBUTED"
          ]
        },
        "fork_repo": {
          "$ref": "#/$defs/nullableRepository"
        },
        "fork_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "last_audited": {
          "$ref": "#/$defs/date"
        }
      }
    }
  }
}
